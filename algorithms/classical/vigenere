
def vigenere_encrypt(text: str, key: str) -> str:
    """Chiffre un texte avec l'algorithme de Vigenère."""
    result = ""
    key = key.upper()
    key_index = 0  # position actuelle dans la clé

    for char in text:
        if char.isupper():
            shift = ord(key[key_index % len(key)]) - ord('A')
            result += chr((ord(char) - ord('A') + shift) % 26 + ord('A'))
            key_index += 1
        elif char.islower():
            shift = ord(key[key_index % len(key)]) - ord('A')
            result += chr((ord(char) - ord('a') + shift) % 26 + ord('a'))
            key_index += 1
        else:
            result += char  # espaces, ponctuation non décalés, clé non avancée

    return result


def vigenere_decrypt(text: str, key: str) -> str:
    """Déchiffre un texte chiffré avec Vigenère (décale dans l'autre sens)."""
    result = ""
    key = key.upper()
    key_index = 0

    for char in text:
        if char.isupper():
            shift = ord(key[key_index % len(key)]) - ord('A')
            result += chr((ord(char) - ord('A') - shift) % 26 + ord('A'))
            key_index += 1
        elif char.islower():
            shift = ord(key[key_index % len(key)]) - ord('A')
            result += chr((ord(char) - ord('a') - shift) % 26 + ord('a'))
            key_index += 1
        else:
            result += char

    return result
